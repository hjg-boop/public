# ============================
# SERVER
# ============================
PORT=5000
NODE_ENV=development

# Used by the Faculty "current class" attendance auto-detection to match
# the server clock against your timetable's start/end times. Set this to
# your college's actual timezone.
TZ=Asia/Kolkata

# ============================
# DATABASE (MongoDB Atlas)
# ============================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/college-portal?retryWrites=true&w=majority

# ============================
# AUTH
# ============================
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ============================
# FRONTEND
# ============================
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================
# CERTIFICATE / ID CARD BRANDING
# ============================
# Used only on generated certificate & ID card PDFs.
COLLEGE_NAME=Your College Name
COLLEGE_ADDRESS=

# ============================
# FILE STORAGE
# ============================
# This project ships with local disk storage out of the box (backend/uploads)
# so it runs with zero extra setup. For production, swap services/fileStorage.js
# for a cloud provider (Cloudinary / AWS S3 / Firebase Storage) using these:
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_URL=
FILE_STORAGE_KEY=
FILE_STORAGE_SECRET=
FILE_STORAGE_BUCKET=

# ============================
# ADMIN SEED ACCOUNT (created by `npm run seed`)
# ============================
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@12345

# Shown in the SELLER band of fee receipts (Admin > Settings overrides these)
COLLEGE_EMAIL=
COLLEGE_PHONE=
